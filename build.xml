<?xml version="1.0" encoding="UTF-8"?>
<project name="MinesweeperOnline" default="compile" basedir=".">
    <description>MinesweeperOnline - Turn-based competitive online minesweeper system</description>

    <!-- Global Properties -->
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build"/>
    <property name="build.classes.dir" value="${build.dir}/classes"/>
    <property name="dist.dir" value="dist"/>
    <property name="dist.jar" value="${dist.dir}/MinesweeperOnline.jar"/>
    <property name="lib.dir" value="lib"/>

    <!-- Compilation and Runtime Classpath -->
    <path id="classpath">
        <fileset dir="${lib.dir}">
            <include name="*.jar"/>
        </fileset>
    </path>

    <path id="run.classpath">
        <pathelement location="${build.classes.dir}"/>
        <path refid="classpath"/>
    </path>

    <!-- Clean build products -->
    <target name="clean" description="Removes build and distribution directories">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
        <echo message="Clean completed."/>
    </target>

    <!-- Initialize build directories -->
    <target name="init">
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <!-- Compile Java sources -->
    <target name="compile" depends="init" description="Compiles Java source files">
        <javac srcdir="${src.dir}"
               destdir="${build.classes.dir}"
               classpathref="classpath"
               includeantruntime="false"
               encoding="UTF-8"
               debug="true"
               source="26"
               target="26">
        </javac>
        <copy todir="${build.classes.dir}">
            <fileset dir="${src.dir}">
                <exclude name="**/*.java"/>
            </fileset>
        </copy>
        <mkdir dir="bin"/>
        <copy todir="bin" failonerror="false">
            <fileset dir="${build.classes.dir}"/>
        </copy>
        <copy todir="C:/Users/ADMIN/AppData/Roaming/Antigravity IDE/User/workspaceStorage/20648212c74a7e3bb93485f77ca2fc45/redhat.java/jdt_ws/MinesweeperOnline_e2ee376f/bin" failonerror="false">
            <fileset dir="${build.classes.dir}"/>
        </copy>
        <echo message="Compilation successful."/>
    </target>

    <!-- Package application into executable JAR -->
    <target name="jar" depends="compile" description="Packages classes and libraries into a JAR">
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="minesweeperonline.server.MainServer"/>
                <attribute name="Class-Path" value="lib/gson.jar lib/mysql-connector-j.jar"/>
            </manifest>
        </jar>
        <mkdir dir="${dist.dir}/lib"/>
        <copy todir="${dist.dir}/lib">
            <fileset dir="${lib.dir}">
                <include name="*.jar"/>
            </fileset>
        </copy>
        <echo message="JAR created at: ${dist.jar}"/>
    </target>

    <!-- Run MainServer -->
    <target name="run-server" depends="compile" description="Starts the Minesweeper TCP Server">
        <echo message="Starting Minesweeper Server..."/>
        <java classname="minesweeperonline.server.MainServer"
              classpathref="run.classpath"
              fork="true">
        </java>
    </target>

    <!-- Run MainClient -->
    <target name="run-client" depends="compile" description="Starts the Minesweeper Swing Client">
        <echo message="Starting Minesweeper Client..."/>
        <java classname="minesweeperonline.client.MainClient"
              classpathref="run.classpath"
              fork="true">
        </java>
    </target>

</project>
